# === ClickHouse: market data (read-only) ===========================
# Proxied through nginx on the box so it rides the existing Cloudflare TLS.
# Port 8123 is NOT open in the firewall, deliberately: the HTTP interface
# authenticates with basic auth, which over a raw public port would put the
# password on the wire in clear text on every query.
CLICKHOUSE_URL=https://api.polyx.trade/ch
CLICKHOUSE_USER=solagents
CLICKHOUSE_PASSWORD=

# Shared secret for that proxy. Without it the URL would be a public ClickHouse
# endpoint guarded only by a password; with it, scanners get 403 before
# ClickHouse is touched. Leave empty when connecting to localhost directly.
CLICKHOUSE_PROXY_KEY=

# === Postgres: strategies, runs, positions, fills ==================
# The box's Postgres - the SAME database the on-box service uses, so there is one
# dataset, not two. The `solagents` role owns only the sa_* tables and has no
# grants on the polyx application tables, so a leaked credential cannot read
# accounts. Remote access is hostssl-only; a plaintext attempt is refused.
#
# Note: sslmode is stripped from this URL by the app and applied explicitly.
# pg-connection-string reads sslmode=require as verify-full and its result
# overrides the ssl object passed to Pool, which fails against the box's
# self-signed certificate.
DATABASE_URL=postgresql://solagents:PASSWORD@$BOX_HOST:5432/polyx?sslmode=require

# === Anthropic =====================================================
ANTHROPIC_API_KEY=
COMPILE_MODEL=claude-opus-5

# Coin scoring runs over the firehose, so this is the line item that matters.
# Haiku at ~$0.0005/coin, and SCORE_MAX_COINS is a hard ceiling checked before
# every run - 30,000 is about $15.
SCORE_MODEL=claude-haiku-4-5
SCORE_MAX_COINS=30000

IPFS_GATEWAY=https://ipfs.io

# === Paper trading engine ==========================================
# ONE instance only. The box runs it (next to the data, always on), so leave
# this unset off-box. Two engines would each open a position for the same coin
# on the same run and double every trade the leaderboard reports.
# PAPER_ENGINE=true

# Railway injects PORT; this is the local fallback.
AGENTS_PORT=3002

# ── live trading ────────────────────────────────────────────────────────────
# 32 bytes of hex. Encrypts run wallet secret keys at rest (AES-256-GCM).
# Generate with: openssl rand -hex 32
# Losing this makes every live wallet unspendable, so back it up before funding
# anything. Leave it unset and live trading stays off; paper is unaffected.
LIVE_WALLET_KEY=

# Our own validator. A public RPC works but adds a queue in front of every buy.
SOLANA_RPC=http://127.0.0.1:8899

# Jupiter swap API. lite-api is the free tier; api.jup.ag takes a key.
JUPITER_API=https://lite-api.jup.ag/swap/v1
