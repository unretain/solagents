# ── ClickHouse: the market data ────────────────────────────────────
# Lives on the bare-metal box and is NOT moving — it is fed by the validator's
# Geyser stream. Railway connects to it over the public IP.
#
# SECURITY: 8123 currently listens on 0.0.0.0 with only basic auth. Before this
# is a public site, either firewall it to Railway's egress range or put it behind
# nginx with TLS. Anyone who finds the port can read the whole trade history.
CLICKHOUSE_URL=http://88.216.198.213:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# ── Postgres: strategies, runs, fills ──────────────────────────────
# On Railway use the managed Postgres plugin and let it inject DATABASE_URL.
# Apply postgres/01_schema.sql to it once.
DATABASE_URL=postgresql://user:pass@host:5432/railway

# ── Anthropic ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# Strategy compilation: runs once per save, so cost is negligible.
COMPILE_MODEL=claude-opus-5

# Coin scoring: runs over the firehose, so this is the line item that matters.
# Haiku at ~$0.0005/coin. SCORE_MAX_COINS is a HARD ceiling checked before every
# run — 30,000 is about $15. Raise it deliberately, never "to see what happens".
SCORE_MODEL=claude-haiku-4-5
SCORE_MAX_COINS=30000

# IPFS gateway for coin metadata descriptions. The box self-hosts one; from
# Railway use a public gateway or the box's, if you expose 8080.
IPFS_GATEWAY=https://ipfs.io

# Railway sets PORT itself; this is the local fallback.
AGENTS_PORT=3002
